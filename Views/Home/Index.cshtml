@model Tesko.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="display-5 fw-bold text-dark mb-1">Dashboard</h1>
    <p class="text-muted">Overview of asset allocation and requests.</p>
    <a asp-controller="Requests" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Quick Request</a>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card h-100 border-start border-4 border-primary">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                        <i class="bi bi-box-seam text-primary fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0 text-muted">Total Assets</h5>
                </div>
                <h2 class="display-6 fw-bold mb-0" id="totalAssets">@Model.AssetStocks.Sum(a => a.Total)</h2>
                <small class="text-muted">Items in inventory</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-start border-4 border-success">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="bg-success bg-opacity-10 p-2 rounded me-3">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0 text-muted">Available</h5>
                </div>
                <h2 class="display-6 fw-bold mb-0" id="availableAssets">@Model.AssetStocks.Sum(a => a.Available)</h2>
                <small class="text-success">Ready for allocation</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="bg-warning bg-opacity-10 p-2 rounded me-3">
                        <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0 text-muted">Low Stock</h5>
                </div>
                <h2 class="display-6 fw-bold mb-0" id="lowStockAssets">@Model.AssetStocks.Count(a => a.Available < 5)</h2>
                <small class="text-warning">Items below threshold</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Stock Distribution</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 300px; width: 100%;">
                    <canvas id="stockChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Top Requested</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.TopItems)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @item.Name
                            <span class="badge bg-primary rounded-pill">@item.RequestCount</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>Top Requesters</h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.TopRequesters)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @item.Name
                            <span class="badge bg-success rounded-pill">@item.RequestCount</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('stockChart').getContext('2d');
        var stockChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.AssetStocks.Select(x => x.Name))),
                datasets: [{
                    label: 'Available Stock',
                    data: @Html.Raw(Json.Serialize(Model.AssetStocks.Select(x => x.Available))),
                    backgroundColor: 'rgba(16, 185, 129, 0.2)',
                    borderColor: 'rgba(16, 185, 129, 1)',
                    borderWidth: 1
                },
                {
                    label: 'Total Stock',
                    data: @Html.Raw(Json.Serialize(Model.AssetStocks.Select(x => x.Total))),
                    backgroundColor: 'rgba(37, 99, 235, 0.2)',
                    borderColor: 'rgba(37, 99, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
        if (window.registerDashboardUpdateHandler) {
            window.registerDashboardUpdateHandler(function () {
                updateDashboard();
            });
        }

        updateDashboard();

        function updateDashboard() {
            fetch('/Home/GetDashboardData')
                .then(response => response.json())
                .then(data => {
                    // Update Chart
                    stockChart.data.labels = data.assetStocks.map(x => x.name);
                    stockChart.data.datasets[0].data = data.assetStocks.map(x => x.available);
                    stockChart.data.datasets[1].data = data.assetStocks.map(x => x.total);
                    stockChart.update();

                    // Update Stats Cards
                    const total = data.assetStocks.reduce((sum, item) => sum + item.total, 0);
                    const available = data.assetStocks.reduce((sum, item) => sum + item.available, 0);
                    const lowStock = data.assetStocks.filter(item => item.available < 5).length;

                    document.getElementById('totalAssets').innerText = total;
                    document.getElementById('availableAssets').innerText = available;
                    document.getElementById('lowStockAssets').innerText = lowStock;
                });
        }
    </script>
}
