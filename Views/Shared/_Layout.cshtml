<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tesko</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tesko.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill me-2"></i>Tesko
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Assets" asp-action="Index">
                                    <i class="bi bi-boxes me-1"></i> Inventory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Users
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Requests" asp-action="Index">
                                <i class="bi bi-list-check me-1"></i> My Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Requests" asp-action="History">
                                <i class="bi bi-clock-history me-1"></i> History
                            </a>
                        </li>

                        @if (User.IsInRole("Approver") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Requests" asp-action="ApprovalQueue">
                                    <i class="bi bi-check-circle me-1"></i> Approvals
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown me-3">
                                <a class="btn btn-outline-secondary position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell"></i>
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notificationDropdown" style="min-width: 320px; max-width: 360px;">
                                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                        <span class="fw-semibold">Notifications</span>
                                        <button class="btn btn-link btn-sm text-decoration-none" type="button" id="clearNotificationsBtn">Mark all read</button>
                                    </div>
                                    <div id="notificationList" class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                                        <div class="list-group-item text-muted small text-center">No notifications yet.</div>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="btn btn-outline-primary dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li><span class="dropdown-header">Signed in as <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div id="notificationContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Tesko - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script>
        (function () {
            const container = document.getElementById('notificationContainer');
            const badge = document.getElementById('notificationBadge');
            const list = document.getElementById('notificationList');
            const clearBtn = document.getElementById('clearNotificationsBtn');
            const notificationState = {
                items: [],
                unread: 0,
                max: 20
            };

            function updateBadge() {
                if (!badge) {
                    return;
                }

                if (notificationState.unread > 0) {
                    badge.textContent = notificationState.unread;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }

            function renderList() {
                if (!list) {
                    return;
                }

                list.innerHTML = '';
                if (!notificationState.items.length) {
                    const empty = document.createElement('div');
                    empty.className = 'list-group-item text-muted small text-center';
                    empty.textContent = 'No notifications yet.';
                    list.appendChild(empty);
                    return;
                }

                notificationState.items.forEach(function (item) {
                    const entry = document.createElement('div');
                    entry.className = 'list-group-item';
                    const title = document.createElement('div');
                    title.className = 'fw-semibold small';
                    title.textContent = item.title;
                    const message = document.createElement('div');
                    message.className = 'small';
                    message.textContent = item.message;
                    const meta = document.createElement('div');
                    meta.className = 'text-muted text-uppercase small mt-1';
                    meta.textContent = item.timestamp;
                    entry.appendChild(title);
                    entry.appendChild(message);
                    entry.appendChild(meta);
                    list.appendChild(entry);
                });
            }

            function addNotificationItem(title, message) {
                const timestamp = new Date().toLocaleTimeString();
                notificationState.items.unshift({ title: title, message: message, timestamp: timestamp });
                if (notificationState.items.length > notificationState.max) {
                    notificationState.items.pop();
                }
                notificationState.unread += 1;
                renderList();
                updateBadge();
            }

            function markAllRead() {
                if (notificationState.unread > 0) {
                    fetch('/api/notifications/mark-read', { method: 'POST' })
                        .catch(function(err) { console.error(err); });
                }
                notificationState.unread = 0;
                updateBadge();
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', markAllRead);
            }

            document.addEventListener('show.bs.dropdown', function (event) {
                var target = event.target;
                if (target && target.id === 'notificationDropdown') {
                    markAllRead();
                }
            });

            function fetchNotifications() {
                fetch('/api/notifications/unread')
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (Array.isArray(data)) {
                            notificationState.items = data.map(function(n) {
                                return {
                                    title: n.title,
                                    message: n.message,
                                    timestamp: n.timestamp
                                };
                            });
                            notificationState.unread = data.length;
                            renderList();
                            updateBadge();
                        }
                    })
                    .catch(function(err) { console.error(err); });
            }

            renderList();
            updateBadge();
            fetchNotifications();

            window.notificationCenter = {
                show: function (title, message, variant) {
                    if (list) {
                        addNotificationItem(title, message);
                    }

                    if (!container || typeof bootstrap === 'undefined') {
                        return;
                    }

                    const toastElement = document.createElement('div');
                    toastElement.className = 'toast text-bg-' + (variant || 'primary') + ' border-0 shadow';
                    toastElement.setAttribute('role', 'alert');
                    toastElement.setAttribute('aria-live', 'assertive');
                    toastElement.setAttribute('aria-atomic', 'true');

                    const wrapper = document.createElement('div');
                    wrapper.className = 'd-flex';

                    const body = document.createElement('div');
                    body.className = 'toast-body';
                    const strong = document.createElement('strong');
                    strong.textContent = title + ': ';
                    body.appendChild(strong);
                    body.appendChild(document.createTextNode(message));

                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn-close btn-close-white me-2 m-auto';
                    button.setAttribute('data-bs-dismiss', 'toast');
                    button.setAttribute('aria-label', 'Close');

                    wrapper.appendChild(body);
                    wrapper.appendChild(button);
                    toastElement.appendChild(wrapper);
                    container.appendChild(toastElement);

                    const toast = new bootstrap.Toast(toastElement, { delay: 5000 });
                    toast.show();
                    toastElement.addEventListener('hidden.bs.toast', function () {
                        toastElement.remove();
                    });
                }
            };

            if (window.signalRInitialized || typeof signalR === 'undefined') {
                return;
            }

            window.signalRInitialized = true;
            window.dashboardUpdateHandlers = [];
            window.registerDashboardUpdateHandler = function (handler) {
                if (typeof handler === 'function') {
                    window.dashboardUpdateHandlers.push(handler);
                }
            };

            const connection = new signalR.HubConnectionBuilder().withUrl('/dashboardHub').build();
            window.dashboardConnection = connection;

            connection.on('ReceiveDashboardUpdate', function () {
                window.dashboardUpdateHandlers.forEach(function (cb) {
                    try {
                        cb();
                    } catch (err) {
                        console.error(err);
                    }
                });
            });

            connection.on('ReceiveNewRequestNotification', function (payload) {
                if (!payload) {
                    return;
                }
                const message = payload.requester + ' requested ' + payload.quantity + '  ' + payload.asset;
                window.notificationCenter.show('New Request', message, 'info');
            });

            connection.on('ReceiveRequestDecisionNotification', function (payload) {
                if (!payload) {
                    return;
                }
                const parts = [];
                parts.push(payload.asset + ' (' + payload.quantity + ')');
                if (payload.comment) {
                    parts.push('Comment: ' + payload.comment);
                }
                if (payload.approver) {
                    parts.push('by ' + payload.approver);
                }
                const variant = payload.status === 'Approved' ? 'success' : 'danger';
                window.notificationCenter.show('Request ' + payload.status, parts.join(' | '), variant);
            });

            connection.start().catch(function (err) { console.error(err.toString()); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
