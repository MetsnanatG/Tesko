@model IEnumerable<Tesko.Models.User>

@{
    ViewData["Title"] = "Login";
    Layout = null; // Use a separate layout or no layout for login if desired, but here we'll just style it
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Tesko</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            border: none;
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            border-radius: 1rem;
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            padding: 2rem;
            text-align: center;
            color: white;
        }
        .login-body {
            padding: 2rem;
            background: white;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-box-seam-fill display-4 mb-2"></i>
            <h2 class="fw-bold mb-0">Tesko</h2>
            <p class="mb-0 opacity-75">Test Data Management System</p>
        </div>
        <div class="login-body">
            <h5 class="text-center mb-4 text-muted">Sign in to your account</h5>
            <form asp-action="Login" method="post">
                <div class="mb-4">
                    <label for="userId" class="form-label fw-bold text-secondary">Select User Role</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                        <select name="userId" class="form-select form-select-lg border-start-0 bg-light">
                            @foreach (var user in Model)
                            {
                                <option value="@user.Id">@user.Name (@user.Role)</option>
                            }
                        </select>
                    </div>
                    <div class="form-text text-muted mt-2">
                        <i class="bi bi-info-circle me-1"></i> Select a user to simulate authentication.
                    </div>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Sign In <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </form>
        </div>
        <div class="bg-light p-3 text-center border-top">
            <small class="text-muted">&copy; 2025 Tesko Inc.</small>
        </div>
    </div>

</body>
</html>
