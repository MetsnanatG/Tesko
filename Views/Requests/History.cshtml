@model IEnumerable<Tesko.Models.Request>

@{
    ViewData["Title"] = "Approval History";
    var isPrivileged = User.IsInRole("Admin") || User.IsInRole("Approver");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-clock-history me-2"></i>Approval History</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            @if (isPrivileged)
                            {
                                <th>Requester</th>
                            }
                            <th>Asset</th>
                            <th>Quantity</th>
                            <th>Purpose</th>
                            <th>Request Date</th>
                            <th>Action Date</th>
                            <th>Status</th>
                            <th>Approver</th>
                            <th>Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusBadge = item.Status == "Approved" ? "bg-success" : "bg-danger";
                            <tr>
                                @if (isPrivileged)
                                {
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle-sm bg-secondary text-white me-2">
                                                @(item.User?.Name?.Substring(0, 1).ToUpper() ?? "?")
                                            </div>
                                            <span>@item.User?.Name</span>
                                        </div>
                                    </td>
                                }
                                <td>@item.Asset?.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.Purpose</td>
                                <td>@item.RequestDate.ToString("g")</td>
                                <td>@item.ActionDate?.ToString("g")</td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill">@item.Status</span>
                                </td>
                                <td>@item.Approver?.Name</td>
                                <td class="text-muted small">@item.Comment</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="@(isPrivileged ? 9 : 8)" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                    No history found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
    }
</style>
